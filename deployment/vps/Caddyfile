{
    email {$TLS_EMAIL}
}
{$APP_DOMAIN} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
    handle /api/* {
        reverse_proxy api:8080 {
            transport http {
                response_header_timeout 690s
            }
        }
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
