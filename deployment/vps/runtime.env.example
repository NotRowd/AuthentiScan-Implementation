# Private file: save as secrets/runtime.env on the server; never commit/share.
AUTHENTISCAN_SMTP_USER=REPLACE_GMAIL
AUTHENTISCAN_SMTP_PASSWORD=REPLACE_16_LETTER_APP_PASSWORD
AUTHENTISCAN_BILLING_MODE=test
PAYMONGO_TEST_SECRET_KEY=REPLACE_TEST_KEY
PAYMONGO_TEST_WEBHOOK_SECRET=REPLACE_PUBLIC_WEBHOOK_SIGNING_SECRET
AUTHENTISCAN_BILLING_TEST_USERS=REPLACE_DESIGNATED_FIREBASE_UID
# Use * instead of the UID list to allow all signed-in accounts to test checkout.
AUTHENTISCAN_PRO_PRICE_CENTAVOS=19900
AUTHENTISCAN_PURCHASE_TYPE=one_time
