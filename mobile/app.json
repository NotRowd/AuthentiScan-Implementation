{
  "expo": {
    "name": "AuthentiScan",
    "slug": "authentiscan",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/AuthentiScan-Logo.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F6FAFD",
    "splash": {
      "image": "./assets/AuthentiScan-Logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6FAFD"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.authentiscan.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6FAFD",
        "foregroundImage": "./assets/AuthentiScan-Logo.png"
      },
      "package": "com.authentiscan.app",
      "predictiveBackGestureEnabled": false,
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "authentiscan",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "AuthentiScan needs access to your photo library to analyze images for AI manipulation.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-system-ui"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
